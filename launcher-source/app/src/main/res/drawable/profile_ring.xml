<?xml version="1.0" encoding="utf-8"?>
<!-- Focused profile: a white ring around the avatar (tvOS). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval"><stroke android:width="3dp" android:color="#FFFFFFFF" /></shape>
    </item>
    <item><shape android:shape="oval"><solid android:color="#00000000" /></shape></item>
</selector>
