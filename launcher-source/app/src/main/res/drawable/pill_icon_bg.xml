<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS status pill button: a white circle when focused, a soft grey one while its panel is open. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval"><solid android:color="#59FFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#00000000" /></shape>
    </item>
</selector>
