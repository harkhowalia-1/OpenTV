<?xml version="1.0" encoding="utf-8"?>
<!-- Get / Open: App Store blue, white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="#FFFFFFFF" /><corners android:radius="24dp" /></shape></item>
    <item><shape><solid android:color="#FF0A84FF" /><corners android:radius="24dp" /></shape></item>
</selector>
