<?xml version="1.0" encoding="utf-8"?>
<!-- Focused tile: tvOS specular sheen across the top and a fine light rim, exactly on the tile's corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#47FFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#59FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>
