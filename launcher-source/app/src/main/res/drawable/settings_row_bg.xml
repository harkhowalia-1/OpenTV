<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS Settings row: transparent at rest, white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#14FFFFFF" /><corners android:radius="14dp" /></shape>
    </item>
</selector>
