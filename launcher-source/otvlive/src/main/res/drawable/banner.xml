            <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="400" android:endY="112.5">
                <item android:offset="0" android:color="#FFFF7AE6" />
                <item android:offset="1" android:color="#FF8A34FF" />
            </gradient>
        </aapt:attr>
    </path>
    <group android:translateY="-7.5">
        <path
